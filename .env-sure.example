# Rails secret base (openssl rand -hex 64).
SECRET_KEY_BASE=
# Postgres password, shared by the database and the app (openssl rand -hex 32).
POSTGRES_PASSWORD=
# Encrypt bank tokens and MFA secrets at rest (openssl rand -hex 32 for each).
# Keep these with your backups: the database is unreadable without them.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
